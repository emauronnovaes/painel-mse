MYSQL_HOST=dbsubdominios.portalmse.com.br
MYSQL_PORT=3306
MYSQL_USER=painelmse
MYSQL_PASSWORD=
MYSQL_DATABASE=painelmse
PORT=3001

# URL publica desta API (pedido do admin de infra, 17/09/2026) — em producao,
# https://painelmse.portalmse.com.br/api; localmente, http://localhost:3001.
# O codigo ainda nao le esta variavel (CORS continua aberto via `cors()`);
# fica documentada aqui para a convencao de config da infra.
PUBLIC_API_URL=http://localhost:3001

# Mesmo segredo HMAC que o Portal MSE ja emite para o planejamento_dash
# (ver config/sso.local.json la, ou SUPER_APP_SSO_SECRET). NUNCA commitar
# o valor real aqui.
PORTAL_SSO_SECRET=

# Assina as sessoes que esta API emite depois de validar o token do portal.
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_SESSION_TTL_SECONDS=28800

# Chave estatica para integracoes server-to-server (n8n -> /ingest/*).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INGEST_API_KEY=

# Para dominios financeiros (Medicoes, e qualquer outro que tenha RLS por
# obra no Supabase) a API pergunta ao PROPRIO Supabase se a sessao do
# usuario tem acesso, via RPC mse_acesso_total/mse_cps_financeiro — nao e
# segredo, e o mesmo par que ja esta hardcoded (SUPABASE_URL/SUPABASE_KEY)
# no prototipo/index.html.
SUPABASE_URL=https://gebjlhkywtnpfqjrakok.supabase.co
SUPABASE_ANON_KEY=

# API do PortalMSE (rmi_api) — usada por scripts/sync-rmi.js, NAO pelo
# servidor (nao e' lida em server.js). Token e' proprio desse servico,
# diferente do de mapa_compras_api. NUNCA commitar o valor real.
RMI_API_URL=https://portalmse.com.br/microservices/rmi_api
RMI_API_TOKEN=
