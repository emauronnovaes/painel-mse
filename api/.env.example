MYSQL_HOST=dbsubdominios.portalmse.com.br
MYSQL_PORT=3306
MYSQL_USER=painelmse
MYSQL_PASSWORD=
MYSQL_DATABASE=painelmse
PORT=3001

# URL publica desta API (pedido do admin de infra, 17/09/2026) — em producao,
# https://painelmse.portalmse.com.br/api; localmente, http://localhost:3001.
# O codigo ainda nao le esta variavel (CORS continua aberto via `cors()`);
# fica documentada aqui para a convencao de config da infra.
PUBLIC_API_URL=http://localhost:3001

# Mesmo segredo HMAC que o Portal MSE ja emite para o planejamento_dash
# (ver config/sso.local.json la, ou SUPER_APP_SSO_SECRET). NUNCA commitar
# o valor real aqui.
PORTAL_SSO_SECRET=

# Assina as sessoes que esta API emite depois de validar o token do portal.
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_SESSION_TTL_SECONDS=28800

# Chave estatica para integracoes server-to-server (n8n -> /ingest/*).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INGEST_API_KEY=

# Para dominios financeiros (Medicoes, e qualquer outro que tenha RLS por
# obra no Supabase) a API pergunta ao PROPRIO Supabase se a sessao do
# usuario tem acesso, via RPC mse_acesso_total/mse_cps_financeiro — nao e
# segredo, e o mesmo par que ja esta hardcoded (SUPABASE_URL/SUPABASE_KEY)
# no prototipo/index.html.
SUPABASE_URL=https://gebjlhkywtnpfqjrakok.supabase.co
SUPABASE_ANON_KEY=

# API do PortalMSE (rmi_api) — usada por scripts/sync-rmi.js, NAO pelo
# servidor (nao e' lida em server.js). Token e' proprio desse servico,
# diferente do de mapa_compras_api. NUNCA commitar o valor real.
RMI_API_URL=https://portalmse.com.br/microservices/rmi_api
RMI_API_TOKEN=

# API do PortalMSE (mapa_compras_api) — usada por scripts/sync-mapa-compras.js.
# Token PROPRIO desse servico, diferente do de rmi_api (a doc da API avisa
# que usar a chave errada da 403). NUNCA commitar o valor real.
MAPA_COMPRAS_API_URL=https://portalmse.com.br/microservices/mapa_compras_api
MAPA_COMPRAS_API_TOKEN=

# API de Avancos do Hub MSE (api_avancos) — usada pelo SERVIDOR (rotas /eap/*),
# nao por script de sync: e' a fonte direta de cards ativos/efetivo, sem passar
# por tabela. Mesmo token que a credencial "EAP" do n8n ja usa. NUNCA commitar
# o valor real; o navegador nunca ve este token (quem chama o Hub e' a API).
AVANCOS_API_URL=https://portalmse.com.br/microservices/hub_mse/api_avancos/v1
AVANCOS_API_TOKEN=

# OC/CO — microservico SEPARADO, com token PROPRIO (chave de um servico no
# outro da 403, como ja aconteceu entre rmi_api e mapa_compras_api).
# Sao 2 recursos: a lista de OCs e o resumo (totais por status).
# Caminhos confirmados contra a API real em 18/09/2026.
#
# ATENCAO ao mexer em OC_API_PATH: com `id_obra=` no lugar de `obra_id=` a API
# IGNORA o filtro e devolve as OCs de TODAS as obras, com HTTP 200 e sem aviso
# nenhum — dado financeiro de obra que o usuario nao pode ver. E o formato
# v1/orcamentos_complementares/{n} NAO e' por obra: {n} ali e' o id da OC.
# O codigo filtra a resposta por obra_id de qualquer forma (ocApi.js), mas nao
# e' motivo pra configurar errado. NUNCA commitar o token.
OC_API_URL=https://portalmse.com.br/microservices/orcamentos_complementares_api
OC_API_PATH=v1/orcamentos_complementares?obra_id={id_obra}
OC_API_RESUMO_PATH=v1/resumo?obra_id={id_obra}
OC_API_TOKEN=

# Cache das consultas diretas as APIs do Portal (vale para todos os servicos).
# Necessario porque cada chamada leva dezenas de segundos.
PORTAL_CACHE_TTL_SEGUNDOS=600
# Depois do TTL, ate quando o valor velho ainda e' servido caso a origem falhe
# (evita tela vazia quando o Portal cai). 6h por padrao.
PORTAL_CACHE_STALE_MAX_SEGUNDOS=21600
